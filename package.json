{
  "name": "ping-monitoring-system",
  "version": "0.5.0",
  "description": "",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js",
    "dev": "NODE_ENV=development tsx --watch src/main.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "start": "node --env-file=.env.production dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rules": "node scripts/check-rule-coverage.mjs",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "NODE_ENV=production prisma migrate deploy",
    "db:studio:dev": "prisma studio",
    "db:studio:prod": "NODE_ENV=production prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "Jonathan O",
  "license": "MIT",

{
  "name": "ping-monitoring-system",
  "version": "0.5.0",
  "description": "",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js",
    "dev": "NODE_ENV=development tsx --watch src/main.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src tests docs",
    "format:check": "prettier --check src tests docs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env.production dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:timing": "RUN_TIMING_TESTS=true jest tests/application/shared/core/UseCase.test.ts",
    "test:rules": "node scripts/check-rule-coverage.mjs",
    "test:rules:groups": "node scripts/check-rule-coverage.mjs --by-group",
    "test:rules:dev": "node scripts/check-rule-coverage.mjs DEV",
    "test:rules:cus": "node scripts/check-rule-coverage.mjs CUS",
    "test:rules:bil": "node scripts/check-rule-coverage.mjs BIL",
    "test:rules:mon": "node scripts/check-rule-coverage.mjs MON",
    "test:rules:wls": "node scripts/check-rule-coverage.mjs WLS",
    "test:rules:svc": "node scripts/check-rule-coverage.mjs SVC",
    "test:rules:not": "node scripts/check-rule-coverage.mjs NOT",
    "test:rules:idn": "node scripts/check-rule-coverage.mjs IDN",
    "test:rules:tkt": "node scripts/check-rule-coverage.mjs TKT",
    "test:rules:shr": "node scripts/check-rule-coverage.mjs SHR",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand",
    "test:integration:usecases": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"tests/integration/use-cases/\"",
    "test:integration:usecases:device-inventory": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"tests/integration/use-cases/device-inventory/\"",
    "test:integration:usecases:device-monitoring": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"tests/integration/use-cases/device-monitoring/\"",
    "test:integration:usecases:notifications": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"tests/integration/use-cases/notifications/\"",
    "test:integration:usecases:tickets": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"tests/integration/use-cases/tickets/\"",
    "test:integration:routes": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"\\.routes\\.test\\.ts$\"",
    "test:integration:routes:device-inventory": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"(device-model|device|location|scan|vendor)\\.routes\\.test\\.ts$\"",
    "test:integration:routes:device-monitoring": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"(alert|polling)\\.routes\\.test\\.ts$\"",
    "test:integration:routes:wireless-monitoring": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"(wireless-config|wireless)\\.routes\\.test\\.ts$\"",
    "test:integration:routes:billing": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"(bill|contracted-service|service-plan)\\.routes\\.test\\.ts$\"",
    "test:integration:routes:customers": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"customer\\.routes\\.test\\.ts$\"",
    "test:integration:routes:tickets": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"(technician|ticket)\\.routes\\.test\\.ts$\"",
    "test:integration:routes:identity": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"auth\\.routes\\.test\\.ts$\"",
    "test:integration:routes:admin": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.js --runInBand --testPathPattern=\"admin\\.routes\\.test\\.ts$\"",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "NODE_ENV=production prisma migrate deploy",
    "db:studio:dev": "prisma studio",
    "db:studio:prod": "NODE_ENV=production prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "Jonathan O",
  "license": "MIT",
  "dependencies": {
    "@network-utils/arp-lookup": "^2.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.18.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.29",
    "mac-oui-lookup": "^1.1.4",
    "net-snmp": "^3.26.3",
    "node-routeros": "^1.6.8",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.19.0",
    "ping": "^0.4.4",
    "winston": "^3.17.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/ping": "^0.4.4",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prisma": "^6.12.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}

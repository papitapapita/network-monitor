# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
ALLOWED_ORIGINS=
# Optional modules this install runs, comma-separated. Unset = all of them.
# `monitoring` (inventory, device + wireless monitoring, notifications) is
# always on. Optional: customers, billing, quoting, tickets, enforcement —
# billing, quoting and enforcement require customers.
# A monitoring-only customer install: ENABLED_MODULES=monitoring
ENABLED_MODULES=

# ─── Database ─────────────────────────────────────────────────────────────────
# Pooled connection (PgBouncer) — used by the running app.
DATABASE_URL=
# Direct (non-pooled) connection — required for `prisma migrate deploy`.
# On Neon, this is the same host WITHOUT "-pooler" in it. Prisma Migrate's
# advisory-lock mechanism (pg_advisory_lock) needs a stable session and will
# time out with "P1002 ... Timed out trying to acquire a postgres advisory
# lock" if run through a transaction-pooled connection instead.
DIRECT_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
DEVICE_CREDENTIALS_KEY=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Account email: new-sign-in warnings and password reset links (IDN-180..183).
# Reset links point at APP_PUBLIC_URL. Unset SMTP_HOST:
# nothing is sent. Once set, the other three are required. Port 465 uses TLS
# directly; any other port must offer STARTTLS. Default port 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# e.g. Mi Red Control <no-reply@miredcontrol.com>
SMTP_FROM=

# ─── Notifications (Telegram) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Default for the install's alert chat until it is saved from the dashboard
# (NOT-201). Numeric id or @channel.
TELEGRAM_CHAT_ID=
# Where the operator's phone opens the dashboard (LAN IP and port, or the
# tunnel hostname), e.g. http://192.168.1.10:3001. Device alerts link to the
# device's page there (NOT-103). Unset: no app link.
APP_PUBLIC_URL=
# Vendor's own chat — agent-health alerts only (ADR 0002, R6, AGT-023).
# Default until the vendor saves its settings from the dashboard (INS-029).
TELEGRAM_VENDOR_CHAT_ID=
# Bot for the vendor chat; unset = the install's TELEGRAM_BOT_TOKEN.
TELEGRAM_VENDOR_BOT_TOKEN=
# false: run wireless polling without sending wireless alert notices. Default
# until saved from the dashboard (NOT-201, NOT-203).
WIRELESS_ALERT_NOTIFICATIONS_ENABLED=

# ─── Probe agents (ADR 0002) ──────────────────────────────────────────────────
# Origin agents use to reach this backend, baked into every pairing key
# (e.g. https://api.example.com). Unset: agents cannot be paired.
AGENT_PUBLIC_URL=
# Proxy allowed to report the caller's address (X-Forwarded-For). Behind
# Cloudflare Tunnel with cloudflared on this machine: loopback. Unset: none.
TRUST_PROXY=
# Is this server on the monitored network? false for an off-site (VPS)
# install whose devices are reached through on-site agents: no wireless
# polling, reboot or diagnosis for agent devices, and no network scan.
# Unset: true.
SERVER_ON_SITE=

# Absolute path of the folder agent installers are served from (INS-042):
# nms-agent-setup-<v>.exe / .msi and nms-agent-<v>-linux-x64.tar.gz. Read on
# every request, so copying a new version in is enough. Unset: no downloads.
INSTALLERS_DIR=

# ─── Vendor account (IDN-011) ─────────────────────────────────────────────────
# The account of the company that sells and runs this install; the only one
# that can pair or revoke agents and purge data. Checked at every boot: created
# as VENDOR if missing (VENDOR_PASSWORD, 12+ chars, needed only then — remove it
# afterwards), promoted to VENDOR if it exists with another role (its password
# is kept). Unset: no vendor account.
VENDOR_EMAIL=
VENDOR_PASSWORD=

# ─── Subscription (ADR 0002, R17) — vendor-set ───────────────────────────────
# Defaults until the vendor saves its settings from the dashboard (INS-029).
# Last day paid for (YYYY-MM-DD, Colombian time). Unset: nothing enforced.
SUBSCRIPTION_PAID_UNTIL=
# Full-service days after that (0–90, default 3), then read-only days —
# monitoring and alerts stopped, writes refused — before the dashboard locks
# (0–90, default 7).
SUBSCRIPTION_GRACE_DAYS=
SUBSCRIPTION_READ_ONLY_DAYS=

# ─── Notifications (WhatsApp Cloud API) — optional ────────────────────────────
# The token turns notices on and stays here. The other four are defaults until
# the vendor saves its settings from the dashboard (INS-029, NOT-115).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_API_VERSION=v21.0

# ─── Cuenta de cobro issuer ───────────────────────────────────────────────────
# Defaults until the vendor saves its settings from the dashboard (BIL-232):
# all six required ones or none. Logo, locale and time zone stay env-only.
# Quote any value containing "#" — dotenv treats it as a comment otherwise.
ISSUER_NAME=
ISSUER_DOCUMENT_LABEL=NIT
ISSUER_DOCUMENT=
ISSUER_ADDRESS=
ISSUER_CITY=
ISSUER_CONTACT_PHONE=
ISSUER_CONTACT_EMAIL=
ISSUER_ACCENT_COLOR="#1F4E79"
# Filesystem path to a PNG/JPEG; empty skips the logo.
ISSUER_LOGO_PATH=
ISSUER_LOCALE=es-CO
ISSUER_TIME_ZONE=America/Bogota

# ─── Service Enforcement (MikroTik) — optional ────────────────────────────────
# Ignored unless the enforcement module is enabled (ENABLED_MODULES). Router id
# and port are defaults until the vendor saves its settings (SVC-060).
ENFORCEMENT_ROUTER_DEVICE_ID=
ENFORCEMENT_ROUTER_API_PORT=8728
SUSPENSION_RECONCILE_INTERVAL_MS=60000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=

# ─── Data Retention (days) ────────────────────────────────────────────────────
# 1–3650. Defaults until the vendor saves its settings from the dashboard
# (INS-029). DEVICE_DELETE_GRACE_DAYS stays env-only.
PING_RESULT_RETENTION_DAYS=
WIRELESS_SNAPSHOT_RETENTION_DAYS=
ALERT_RETENTION_DAYS=
WIRELESS_ALERT_RECORD_RETENTION_DAYS=

# ─── Live Link Diagnosis ──────────────────────────────────────────────────────
# Most diagnosis sessions running at once, across all devices (WLS-182).
DIAGNOSIS_MAX_SESSIONS=5

# ─── Alerting ─────────────────────────────────────────────────────────────────
# Minutes a device must be continuously DOWN before its outage alert is sent,
# 0–1440. Default until saved from the dashboard (NOT-201).
DEVICE_DOWN_ALERT_DELAY_MINUTES=60

# ─── Seeding ──────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

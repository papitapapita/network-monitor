// ============================================================================
// ISP Watch — V1 Schema
// ============================================================================
// 6 tables. No multi-tenancy. Ping-only monitoring.
// Goal: "I can see what's down and get notified."
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY (users and roles)
// ============================================================================

enum UserRole {
  VENDOR
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole
  // Set while the account is disabled; it cannot sign in and its tokens stop
  // working (IDN-013).
  disabledAt         DateTime? @map("disabled_at") @db.Timestamptz
  // Carried in every token; bumped on a role or password change or on
  // disabling, which ends the sessions already open (IDN-065).
  tokenVersion       Int       @default(0) @map("token_version")
  // Wrong passwords since the last successful sign-in, and the pause they
  // earned (IDN-044).
  failedSignIns      Int       @default(0) @map("failed_sign_ins")
  signInPausedUntil  DateTime? @map("sign_in_paused_until") @db.Timestamptz
  // Two-factor sign-in (IDN-160…): the secret encrypted with the install's
  // key, set before `twoFactorEnabledAt` while setup awaits its first code.
  twoFactorSecret    String?   @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at") @db.Timestamptz
  twoFactorLastStep  Int?      @map("two_factor_last_step")
  recoveryCodeHashes String[]  @default([]) @map("recovery_code_hashes") @db.VarChar(64)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  technician         Technician?
  pushSubscriptions  PushSubscription[]
  inboxNotifications InboxNotification[]
  speedTests         SpeedTestResult[]

  @@map("users")
}

// ============================================================================
// VENDOR (hardware manufacturers)
// ============================================================================
// Managed via API. slug is URL-safe lowercase for programmatic use (e.g. SNMP).
// ============================================================================

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  deviceModels DeviceModel[]

  @@map("vendors")
}

// ============================================================================
// DEVICE MODEL (global hardware catalog)
// ============================================================================
// Managed via API. References Vendor table instead of enum.
// ============================================================================

enum DeviceType {
  ANTENNA
  OTHER
  RADIO
  ROUTER
  ROUTERBOARD
  SERVER
  SWITCH

  @@map("device_type")
}

// The firmware a PoE-out switch model runs, so the app knows how to read its
// ports (PWR-001). Null: the model is not a PoE switch.
enum PoeSwitchOs {
  ROUTEROS
  SWOS

  @@map("poe_switch_os")
}

model DeviceModel {
  id          String       @id @default(uuid()) @db.Uuid
  vendorId    String       @map("vendor_id") @db.Uuid
  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  model       String       @db.VarChar(150)
  deviceType  DeviceType   @map("device_type")
  isWireless  Boolean      @default(false) @map("is_wireless")
  imageUrl    String?      @map("image_url") @db.VarChar(500)
  poeSwitchOs PoeSwitchOs? @map("poe_switch_os")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  devices        Device[]
  quotationItems QuotationLineItem[]

  @@unique([vendorId, model])
  @@map("device_models")
}

// ============================================================================
// LOCATION (infrastructure sites)
// ============================================================================
// Towers, nodes, office, warehouse. Not customer premises.
// ============================================================================

enum LocationType {
  TOWER
  DATACENTER
  POINT_OF_PRESENCE
  OFFICE
  CUSTOMER_PREMISES
  OTHER

  @@map("location_type")
}

model Location {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(150)
  type         LocationType
  municipality String?      @db.VarChar(100)
  neighborhood String?      @db.VarChar(150)
  address      String?      @db.VarChar(255)
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  altitude     Decimal?     @db.Decimal(7, 2)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  devices Device[]

  @@map("locations")
}

// ============================================================================
// DEVICE
// ============================================================================
// Network devices. The core entity.
// Network fields (ip_address) nullable for warehouse inventory.
// ============================================================================

enum DeviceStatus {
  ACTIVE
  COMMISSIONING
  DAMAGED
  DECOMMISSIONED
  INVENTORY

  @@map("device_status")
}

enum DeviceCategory {
  CPE
  WIRELESS_CPE
  ACCESS_POINT
  GATEWAY
  AGGREGATION_SWITCH
  OTHER

  @@map("device_category")
}

enum DeviceOwnerType {
  COMPANY
  CLIENT
  //THIRD_PARTY

  @@map("device_owner")
}

model Device {
  id            String           @id @default(uuid()) @db.Uuid
  deviceModelId String           @map("device_model_id") @db.Uuid
  locationId    String?          @map("location_id") @db.Uuid
  // The on-site agent that reaches this device (ADR 0002). Null: polled
  // in-process, until Insetel's own install moves onto an agent.
  agentId       String?          @map("agent_id") @db.Uuid
  status        DeviceStatus     @default(INVENTORY)
  category      DeviceCategory?
  owner         DeviceOwnerType?

  //Identity
  name         String  @db.VarChar(150)
  serialNumber String? @map("serial_number") @db.VarChar(100)
  // Uniqueness is a PARTIAL index (`WHERE deleted_at IS NULL`), declared in
  // migration 20260811120000 — Prisma's DSL cannot express one, so `@unique`
  // is deliberately absent here. A soft-deleted unit must release its address
  // so a replacement can take it.
  macAddress   String? @map("mac_address") @db.VarChar(17)
  ipAddress    String? @map("ip_address") @db.VarChar(45)
  // Generated column (migration 20260903130000) — Postgres derives it from
  // `ipAddress` via inet_send() on every write. Prisma's DSL cannot express
  // a generated column, so this is declared as an ordinary field and is
  // never written to directly; it exists only to be ordered by. The
  // dbgenerated() default mirrors Postgres's own pg_get_expr() rendering of
  // the generation expression so `migrate dev`'s diff stops mistaking it for
  // a missing default and proposing an invalid DROP DEFAULT on it.
  ipSortKey    Bytes?  @default(dbgenerated("inet_send((ip_address)::inet)")) @map("ip_sort_key")
  description  String? @db.Text

  // Lifecycle
  installedDate DateTime? @map("installed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy     String?   @map("deleted_by") @db.Uuid

  // Replacement lineage. Only `replacesDeviceId` is stored; `replacedBy` is its
  // back-reference rather than a second column that could drift out of step
  // with it. Not unique: a unit that goes back into service after being
  // superseded can be replaced again, so one row may have several successors
  // over its life. The current one is the most recently created.
  replacedAt       DateTime? @map("replaced_at") @db.Timestamptz
  replacesDeviceId String?   @map("replaces_device_id") @db.Uuid

  // Topology (DEV-180): the device this one hangs off on the network. Null
  // is a root — the gateway, or a link nobody has declared yet.
  upstreamDeviceId String? @map("upstream_device_id") @db.Uuid

  // Monitoring
  monitoringEnabled Boolean @default(true) @map("monitoring_enabled")

  // Relations
  deviceModel                  DeviceModel                     @relation(fields: [deviceModelId], references: [id], onDelete: Restrict)
  location                     Location?                       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  agent                        ProbeAgent?                     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  replaces                     Device?                         @relation("DeviceReplacement", fields: [replacesDeviceId], references: [id], onDelete: SetNull)
  replacedBy                   Device[]                        @relation("DeviceReplacement")
  upstream                     Device?                         @relation("DeviceUpstream", fields: [upstreamDeviceId], references: [id], onDelete: SetNull)
  downstream                   Device[]                        @relation("DeviceUpstream")
  pollingConfiguration         PollingConfiguration?
  deviceState                  DeviceState?
  notificationPolicy           DeviceNotificationPolicy?
  pingResults                  PingResult[]
  alertEvents                  AlertEvent[]
  inboxNotifications           InboxNotification[]
  deviceCredentials            DeviceCredentials?
  wirelessSnapshots            WirelessSnapshot[]
  wirelessAlertRecords         WirelessAlertRecord[]
  wirelessPollingConfiguration WirelessPollingConfiguration?
  alertThresholdOverride       WirelessAlertThresholdOverride?
  contractedService            ContractedService?
  tickets                      Ticket[]
  agentIndexes                 ProbeAgentDeviceIndex[]
  configBackups                ConfigBackup[]
  backupState                  DeviceBackupState?

  @@index([monitoringEnabled])
  @@index([deletedAt])
  @@index([ipSortKey])
  @@index([replacesDeviceId])
  @@index([agentId])
  @@index([upstreamDeviceId])
  @@map("devices")
}

// ============================================================================
// DEVICE STATE (current status cache — 1:1 with Device)
// ============================================================================
// Updated every ping cycle. This is what the dashboard reads.
// One row per device. Overwritten, not appended.
// UNKNOWN means nobody is watching: either the device has never been polled,
// or monitoring was turned off and the last reading must not be shown as current.
// ============================================================================

enum DiscoverySource {
  SCAN
  AP_STATION

  @@map("discovery_source")
}

// A MAC the network shows that no device in inventory owns (DEV-200). One row
// per MAC; deleted once a device claims it (DEV-203).
model DiscoveredDevice {
  id            String          @id @default(uuid()) @db.Uuid
  macAddress    String          @unique @map("mac_address") @db.VarChar(17)
  ipAddress     String?         @map("ip_address") @db.VarChar(45)
  manufacturer  String?         @db.VarChar(150)
  source        DiscoverySource
  // The CIDR a scan last saw it on; null until a scan sees it.
  segment       String?         @db.VarChar(18)
  hostname      String?         @db.VarChar(100)
  model         String?         @db.VarChar(100)
  // The AP whose station list showed it last; no FK, a deleted AP is skipped.
  accessPointId String?         @map("access_point_id") @db.Uuid
  firstSeenAt   DateTime        @map("first_seen_at") @db.Timestamptz
  lastSeenAt    DateTime        @map("last_seen_at") @db.Timestamptz
  ignoredAt     DateTime?       @map("ignored_at") @db.Timestamptz

  @@index([lastSeenAt])
  @@map("discovered_devices")
}

enum ReachabilityStatus {
  UP
  DOWN
  UNKNOWN

  @@map("reachability_status")
}

model DeviceState {
  id                  String             @id @default(uuid()) @db.Uuid
  deviceId            String             @unique @map("device_id") @db.Uuid
  status              ReachabilityStatus @default(UNKNOWN)
  lastSeen            DateTime?          @map("last_seen") @db.Timestamptz
  lastLatencyMs       Decimal?           @map("last_latency_ms") @db.Decimal(8, 2)
  consecutiveFailures Int                @default(0) @map("consecutive_failures")
  lastCheckedAt       DateTime?          @map("last_checked_at") @db.Timestamptz
  // When the current DOWN streak began. Null while UP/UNKNOWN. Drives the
  // delayed down-alert scan (see RaiseOverdueDeviceDownAlertsUseCase) so a
  // brief blip does not page anyone before it has been down long enough.
  downSince           DateTime?          @map("down_since") @db.Timestamptz
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([status, downSince])
  @@map("device_states")
}

// ============================================================================
// PING RESULT (time-series — append only)
// ============================================================================
// One row per ping per device. High volume: 300 devices × 1/min = 432K/day.
// Retention policy: keep raw data 30 days, then delete.
// Partition by month if needed later.
// ============================================================================

model PingResult {
  id             String   @id @default(uuid()) @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  isReachable    Boolean  @map("is_reachable")
  latencyMs      Decimal? @map("latency_ms") @db.Decimal(8, 2)
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz
  // The id the measuring side gave this result — an on-site agent's, so a
  // batch it resends is stored once (ADR 0002, R8). Null when polled
  // in-process.
  sourceResultId String?  @unique @map("source_result_id") @db.VarChar(64)

  // Relations
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, checkedAt(sort: Desc)])
  @@index([checkedAt])
  @@map("ping_results")
}

// ============================================================================
// ALERT EVENT (device went down / recovered)
// ============================================================================
// Created when a device crosses the failure threshold.
// Closed (resolved_at set) when it comes back online.
// This drives notifications (WhatsApp, email).
// ============================================================================

enum AlertSeverity {
  WARNING
  CRITICAL

  @@map("alert_severity")
}

model AlertEvent {
  id                 String        @id @default(uuid()) @db.Uuid
  deviceId           String        @map("device_id") @db.Uuid
  severity           AlertSeverity @default(CRITICAL)
  source             String        @default("") @db.Text
  type               String        @default("") @db.Text
  description        String        @default("") @db.Text
  details            Json          @default("{}")
  startedAt          DateTime      @default(now()) @map("started_at") @db.Timestamptz
  resolvedAt         DateTime?     @map("resolved_at") @db.Timestamptz
  notifiedAt         DateTime?     @map("notified_at") @db.Timestamptz
  recoveryNotifiedAt DateTime?     @map("recovery_notified_at") @db.Timestamptz
  causedByAlertId    String?       @map("caused_by_alert_id") @db.Uuid

  // Relations
  device             Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  causedBy           AlertEvent?         @relation("AlertCause", fields: [causedByAlertId], references: [id], onDelete: SetNull)
  affected           AlertEvent[]        @relation("AlertCause")
  inboxNotifications InboxNotification[]

  @@index([deviceId, startedAt(sort: Desc)])
  @@index([causedByAlertId])
  @@index([resolvedAt])
  @@index([deviceId, type, resolvedAt])
  @@map("alert_events")
}

// ===================================
// POLLING SYSTEM MODELS (Sprint 1)
// ===================================

/// Polling configuration for continuous device monitoring.
/// Defines how often and how many pings should be executed.
model PollingConfiguration {
  id                 String    @id @default(uuid()) @db.Uuid
  deviceId           String    @unique @map("device_id") @db.Uuid
  ipAddress          String?   @map("ip_address") @db.VarChar(45)
  enabled            Boolean   @default(true)
  // Range enforced by a CHECK constraint (migration 20260722010000) — Prisma
  // cannot express CHECK constraints in the schema DSL.
  pingIntervalSecs   Int       @default(60) @map("interval_seconds") // Polling interval (5-86400 seconds)
  failuresBeforeDown Int       @default(3) @map("failures_before_down") // Consecutive failures before marking device as down
  lastPolledAt       DateTime? @map("last_polled_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@map("polling_configurations")
}

/// Per-device notification settings: how the device's quiet hours are
/// chosen — the install's window, its own, or none at all (NOT-170) — which
/// suppress outbound alert notifications (not the alert record itself —
/// see NOT-174 in docs/business-rules/notifications.md), and an optional
/// override of the system-wide down-alert delay.
model DeviceNotificationPolicy {
  id       String @id @default(uuid()) @db.Uuid
  deviceId String @unique @map("device_id") @db.Uuid

  quietHoursMode  QuietHoursMode @default(INHERIT) @map("quiet_hours_mode")
  // Set exactly when the mode is CUSTOM, both or neither — enforced by CHECK
  // constraints (migrations 20260902120000, 20261026120000), not expressible
  // in the Prisma schema DSL.
  quietHoursStart String?        @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd   String?        @map("quiet_hours_end") @db.VarChar(5)

  // null = use the system default (DEVICE_DOWN_ALERT_DELAY_MINUTES).
  // Range also enforced by the same migration's CHECK constraint.
  alertDelayMinutes Int? @map("alert_delay_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_notification_policies")
}

/// INHERIT: the install's quiet hours, if any (NOT-207). CUSTOM: the device's
/// own window. ALWAYS_NOTIFY: never silenced by quiet hours.
enum QuietHoursMode {
  INHERIT
  CUSTOM
  ALWAYS_NOTIFY

  @@map("quiet_hours_mode")
}

/// Global, standing list of alert-type keys (a wireless metric name, or
/// `device_unreachable`) whose outbound notification is suppressed for
/// every device — the alert record itself is unaffected, same as quiet
/// hours (NOT-174). Not per-device: this is "I never want CPU noise",
/// not "not on this radio" — see NOT-19x in
/// docs/business-rules/notifications.md.
model MutedAlertType {
  id        String   @id @default(uuid()) @db.Uuid
  metric    String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("muted_alert_types")
}

/// A phone or browser receiving the install's alerts as push notifications
/// (NOT-220). The endpoint is the push service's address for that browser.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.VarChar(2048)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// One user's copy of something the install told its staff (NOT-260).
/// One row per recipient, so each user's read state is their own.
model InboxNotification {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  category   String        @db.VarChar(20)
  severity   AlertSeverity
  resolved   Boolean       @default(false)
  type       String        @db.VarChar(100)
  title      String        @db.Text
  body       String?       @db.Text
  deviceId   String?       @map("device_id") @db.Uuid
  alertId    String?       @map("alert_id") @db.Uuid
  // A retried delivery of the same notice lands on the same key, so the
  // inbox keeps one copy of it.
  dedupKey   String        @map("dedup_key") @db.VarChar(255)
  occurredAt DateTime      @map("occurred_at") @db.Timestamptz
  readAt     DateTime?     @map("read_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  alert  AlertEvent? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([createdAt])
  @@index([deviceId])
  @@index([alertId])
  @@map("inbox_notifications")
}

enum SpeedTestStatus {
  COMPLETED
  FAILED

  @@map("speed_test_status")
}

// One run of the internet speed test, measured from this server (MON-100).
// A failed run keeps what it measured before failing (MON-103).
model SpeedTestResult {
  id             String          @id @default(uuid()) @db.Uuid
  status         SpeedTestStatus
  downloadMbps   Float?          @map("download_mbps")
  uploadMbps     Float?          @map("upload_mbps")
  latencyMs      Float?          @map("latency_ms")
  jitterMs       Float?          @map("jitter_ms")
  serverLocation String?         @map("server_location") @db.VarChar(50)
  error          String?         @db.VarChar(500)
  startedById    String?         @map("started_by_id") @db.Uuid
  startedByEmail String          @map("started_by_email") @db.VarChar(255)
  startedAt      DateTime        @map("started_at") @db.Timestamptz
  finishedAt     DateTime        @map("finished_at") @db.Timestamptz

  startedBy User? @relation(fields: [startedById], references: [id], onDelete: SetNull)

  @@index([startedAt(sort: Desc)])
  @@index([startedById])
  @@map("speed_test_results")
}

/// The install's notification settings, edited from the dashboard (NOT-200).
/// One row at most (id is always 1); no row means the env defaults apply.
model NotificationSettings {
  id                    Int             @id @default(1) @db.SmallInt
  telegramChatId        String?         @map("telegram_chat_id") @db.VarChar(64)
  downAlertDelayMinutes Int             @map("down_alert_delay_minutes")
  wirelessAlertsEnabled Boolean         @map("wireless_alerts_enabled")
  alertTicketMode       AlertTicketMode @default(SUGGEST) @map("alert_ticket_mode")
  // Install-wide quiet hours (NOT-207); both null or both set (CHECK
  // constraint, migration 20261026120000).
  quietHoursStart       String?         @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd         String?         @map("quiet_hours_end") @db.VarChar(5)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@map("notification_settings")
}

/// Whether a new alert opens a ticket on its own or only offers one (NOT-205).
enum AlertTicketMode {
  SUGGEST
  AUTOMATIC

  @@map("alert_ticket_mode")
}

/// What the vendor runs the install with, edited from the dashboard (INS-028):
/// its own alert chat, the customer's subscription terms and how long data is
/// kept. One row at most (id is always 1); no row means the env defaults apply.
model VendorSettings {
  id                               Int       @id @default(1) @db.SmallInt
  vendorTelegramChatId             String?   @map("vendor_telegram_chat_id") @db.VarChar(64)
  subscriptionPaidUntil            DateTime? @map("subscription_paid_until") @db.Date
  subscriptionGraceDays            Int       @map("subscription_grace_days")
  subscriptionReadOnlyDays         Int       @map("subscription_read_only_days")
  pingResultRetentionDays          Int       @map("ping_result_retention_days")
  alertRetentionDays               Int       @map("alert_retention_days")
  wirelessSnapshotRetentionDays    Int       @map("wireless_snapshot_retention_days")
  wirelessAlertRecordRetentionDays Int       @map("wireless_alert_record_retention_days")
  /// Each group is all null (not configured) or all set.
  issuerName                       String?   @map("issuer_name") @db.VarChar(200)
  issuerDocumentLabel              String?   @map("issuer_document_label") @db.VarChar(200)
  issuerDocument                   String?   @map("issuer_document") @db.VarChar(200)
  issuerAddress                    String?   @map("issuer_address") @db.VarChar(200)
  issuerCity                       String?   @map("issuer_city") @db.VarChar(200)
  issuerContactPhone               String?   @map("issuer_contact_phone") @db.VarChar(200)
  issuerContactEmail               String?   @map("issuer_contact_email") @db.VarChar(200)
  issuerAccentColorHex             String?   @map("issuer_accent_color_hex") @db.Char(7)
  whatsAppPhoneNumberId            String?   @map("whatsapp_phone_number_id") @db.VarChar(30)
  whatsAppTemplateName             String?   @map("whatsapp_template_name") @db.VarChar(512)
  whatsAppTemplateLanguage         String?   @map("whatsapp_template_language") @db.VarChar(10)
  whatsAppApiVersion               String?   @map("whatsapp_api_version") @db.VarChar(10)
  enforcementRouterDeviceId        String?   @map("enforcement_router_device_id") @db.Uuid
  enforcementRouterApiPort         Int?      @map("enforcement_router_api_port")
  updatedAt                        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("vendor_settings")
}

// ============================================================================
// WIRELESS MONITORING MODELS
// ============================================================================

enum WirelessDeviceType {
  STATION
  ACCESS_POINT

  @@map("wireless_device_type")
}

enum WirelessAlertSeverity {
  WARNING
  CRITICAL

  @@map("wireless_alert_severity")
}

model DeviceCredentials {
  id              String   @id @default(uuid()) @db.Uuid
  deviceId        String   @unique @map("device_id") @db.Uuid
  snmpVersion     Int      @default(3) @map("snmp_version")
  snmpCommunity   String?  @map("snmp_community") @db.VarChar(500)
  snmpV3AuthUser  String?  @map("snmp_v3_auth_user") @db.VarChar(500)
  snmpV3AuthProto String?  @map("snmp_v3_auth_proto") @db.VarChar(20)
  snmpV3AuthKey   String?  @map("snmp_v3_auth_key") @db.VarChar(500)
  snmpV3PrivProto String?  @map("snmp_v3_priv_proto") @db.VarChar(20)
  snmpV3PrivKey   String?  @map("snmp_v3_priv_key") @db.VarChar(500)
  httpUsername    String?  @map("http_username") @db.VarChar(500)
  httpPassword    String?  @map("http_password") @db.VarChar(500)
  snmpPort        Int      @default(161) @map("snmp_port")
  httpPort        Int      @default(443) @map("http_port")
  // RouterOS backups log in over SSH with the HTTP username and password.
  sshPort         Int      @default(22) @map("ssh_port")
  // Live router traffic reads the RouterOS API with the same login.
  apiPort         Int      @default(8728) @map("api_port")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_credentials")
}

model WirelessSnapshot {
  id                String             @id @default(uuid()) @db.Uuid
  deviceId          String             @map("device_id") @db.Uuid
  deviceType        WirelessDeviceType @map("device_type")
  collectedAt       DateTime           @map("collected_at") @db.Timestamptz
  collectionMethod  String             @map("collection_method") @db.VarChar(20)
  signalRxDbm       Int?               @map("signal_rx_dbm")
  signalTxDbm       Int?               @map("signal_tx_dbm")
  noiseFloorDbm     Int?               @map("noise_floor_dbm")
  snrDb             Int?               @map("snr_db")
  ccqPercent        Int?               @map("ccq_percent")
  frequencyMhz      Int?               @map("frequency_mhz")
  channelWidthMhz   Int?               @map("channel_width_mhz")
  throughputTxBps   BigInt?            @map("throughput_tx_bps")
  throughputRxBps   BigInt?            @map("throughput_rx_bps")
  throughputTxPps   BigInt?            @map("throughput_tx_pps")
  throughputRxPps   BigInt?            @map("throughput_rx_pps")
  lanStatus         String?            @map("lan_status") @db.VarChar(10)
  lanSpeedMbps      Int?               @map("lan_speed_mbps")
  lanDuplex         String?            @map("lan_duplex") @db.VarChar(10)
  uptimeSeconds     BigInt?            @map("uptime_seconds")
  cpuLoadPercent    Int?               @map("cpu_load_percent")
  memoryUsedPercent Int?               @map("memory_used_percent")
  firmwareVersion   String?            @map("firmware_version") @db.VarChar(100)
  deviceName        String?            @map("device_name") @db.VarChar(150)
  remoteApMac       String?            @map("remote_ap_mac") @db.VarChar(17)
  remoteApName      String?            @map("remote_ap_name") @db.VarChar(150)
  remoteApIp        String?            @map("remote_ap_ip") @db.VarChar(45)
  remoteApDeviceId  String?            @map("remote_ap_device_id") @db.Uuid
  distanceM         Int?               @map("distance_m")
  latencyMs         Int?               @map("latency_ms")
  capacityTxKbps    Int?               @map("capacity_tx_kbps")
  capacityRxKbps    Int?               @map("capacity_rx_kbps")
  deviceTimeEpoch   BigInt?            @map("device_time_epoch")
  clientsConnected  Int?               @map("clients_connected")
  clientsJson       Json?              @map("clients_json")
  macAddress        String?            @map("mac_address") @db.VarChar(17)
  deviceModel       String?            @map("device_model") @db.VarChar(100)
  ssid              String?            @map("ssid") @db.VarChar(64)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, collectedAt(sort: Desc)])
  @@index([collectedAt])
  @@map("wireless_snapshots")
}

model WirelessAlertRecord {
  id          String                @id @default(uuid()) @db.Uuid
  deviceId    String                @map("device_id") @db.Uuid
  metric      String                @db.VarChar(50)
  severity    WirelessAlertSeverity
  threshold   Decimal               @db.Decimal(12, 4)
  triggeredAt DateTime              @map("triggered_at") @db.Timestamptz
  clearedAt   DateTime?             @map("cleared_at") @db.Timestamptz
  isActive    Boolean               @default(true) @map("is_active")
  lastValue   Decimal               @map("last_value") @db.Decimal(12, 4)
  message     String                @db.Text
  notifiedAt  DateTime?             @map("notified_at") @db.Timestamptz
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, metric, severity, isActive])
  @@index([isActive, triggeredAt(sort: Desc)])
  @@map("wireless_alert_records")
}

model WirelessPollingConfiguration {
  id                      String             @id @default(uuid()) @db.Uuid
  deviceId                String             @unique @map("device_id") @db.Uuid
  ipAddress               String?            @map("ip_address") @db.VarChar(45)
  enabled                 Boolean            @default(true)
  // Range enforced by a CHECK constraint (migration 20260722010000) — Prisma
  // cannot express CHECK constraints in the schema DSL.
  intervalSecs            Int                @default(3600) @map("interval_secs") // Polling interval (60-86400 seconds)
  deviceType              WirelessDeviceType @map("device_type")
  linkCapacityKbps        BigInt?            @map("link_capacity_kbps")
  clientsProvisionedLimit Int?               @map("clients_provisioned_limit")
  provisionedLanSpeedMbps Int?               @map("provisioned_lan_speed_mbps")
  // Consecutive polls the radio reported an AP other than the device's
  // declared upstream (WLS-013).
  parentApMismatchPolls   Int                @default(0) @map("parent_ap_mismatch_polls")
  lastPolledAt            DateTime?          @map("last_polled_at") @db.Timestamptz
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@map("wireless_polling_configurations")
}

/// The install's wireless alert thresholds, edited from the dashboard
/// (WLS-200). One row at most (id is always 1); no row means the defaults in
/// AlertThresholds apply. JSON rather than columns: the groups are validated
/// as a whole by the value object, and a group added later falls back to its
/// default on rows saved before it existed.
model WirelessAlertThresholds {
  id         Int      @id @default(1) @db.SmallInt
  thresholds Json     @db.JsonB
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("wireless_alert_thresholds")
}

/// One device's departures from the install's thresholds (WLS-201). Only the
/// groups it overrides are stored; no row means it follows the install.
model WirelessAlertThresholdOverride {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @unique @map("device_id") @db.Uuid
  overrides Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("wireless_alert_threshold_overrides")
}

// ============================================================================
// CUSTOMERS BOUNDED CONTEXT
// ============================================================================

enum ContractedServiceStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("contracted_service_status")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String   @unique @db.VarChar(20)
  email     String?  @unique @db.VarChar(255)
  cedula    String?  @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contractedServices ContractedService[]
  bills              Bill[]
  tickets            Ticket[]
  quotations         Quotation[]
  collectionAccounts CollectionAccount[]

  @@map("customers")
}

model ServicePlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  downloadMbps Int      @map("download_mbps")
  uploadMbps   Int      @map("upload_mbps")
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(12, 2)
  description  String?  @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  contractedServices ContractedService[]

  @@map("service_plans")
}

model ContractedService {
  id            String                  @id @default(uuid()) @db.Uuid
  customerId    String                  @map("customer_id") @db.Uuid
  servicePlanId String                  @map("service_plan_id") @db.Uuid
  deviceId      String?                 @unique @map("device_id") @db.Uuid
  status        ContractedServiceStatus @default(PENDING)
  startDate     DateTime                @map("start_date") @db.Timestamptz
  /// 15 or 30: the day of the month the service's bill is due (CUS-024).
  paymentDay    Int                     @default(30) @map("payment_day") @db.SmallInt
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  servicePlan ServicePlan @relation(fields: [servicePlanId], references: [id], onDelete: Restrict)
  device      Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@map("contracted_services")
}

// ============================================================================
// BILLING BOUNDED CONTEXT
// ============================================================================

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED

  @@map("bill_status")
}

model Bill {
  id                  String     @id @default(uuid()) @db.Uuid
  customerId          String     @map("customer_id") @db.Uuid
  // The one service billed (BIL-007); null on older multi-service bills.
  // Unique per period among non-cancelled bills — a partial index in
  // migration 20261026140000, not expressible in the Prisma schema DSL.
  contractedServiceId String?    @map("contracted_service_id") @db.Uuid
  periodYear          Int        @map("period_year")
  periodMonth         Int        @map("period_month")
  status              BillStatus @default(PENDING)
  issueDate           DateTime   @map("issue_date") @db.Timestamptz
  dueDate             DateTime   @map("due_date") @db.Timestamptz
  paidAt              DateTime?  @map("paid_at") @db.Timestamptz
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lineItems BillLineItem[]
  payment   BillPayment?
  reminders BillReminder[]

  @@index([customerId])
  @@index([status])
  @@index([periodYear, periodMonth])
  @@map("bills")
}

model BillLineItem {
  id                  String    @id @default(uuid()) @db.Uuid
  billId              String    @map("bill_id") @db.Uuid
  contractedServiceId String    @map("contracted_service_id") @db.Uuid
  servicePlanId       String    @map("service_plan_id") @db.Uuid
  planName            String    @map("plan_name") @db.VarChar(100)
  monthlyPrice        Decimal   @map("monthly_price") @db.Decimal(12, 2)
  // What the line charges: the monthly price, or a prorated share (BIL-290).
  amount              Decimal   @db.Decimal(12, 2)
  // Days charged; null on lines issued before these were recorded.
  serviceFrom         DateTime? @map("service_from") @db.Date
  serviceTo           DateTime? @map("service_to") @db.Date

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_line_items")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  NEQUI
  DAVIPLATA
  BRE_B
  OTHER

  @@map("payment_method")
}

// How a bill was paid (BIL-300). One per bill while only full payments are
// taken. recordedByUserId has no foreign key: the record outlives the user.
model BillPayment {
  id               String        @id @default(uuid()) @db.Uuid
  billId           String        @unique @map("bill_id") @db.Uuid
  method           PaymentMethod
  reference        String?       @db.VarChar(100)
  amount           Decimal       @db.Decimal(12, 2)
  paidAt           DateTime      @map("paid_at") @db.Timestamptz
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_payments")
}

// One row per bill per Colombian day a payment reminder went out (BIL-323),
// so a run repeated that day sends nothing twice.
model BillReminder {
  id        String   @id @default(uuid()) @db.Uuid
  billId    String   @map("bill_id") @db.Uuid
  sentOn    DateTime @map("sent_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, sentOn])
  @@map("bill_reminders")
}

enum BillingMode {
  ADVANCE
  ARREARS

  @@map("billing_mode")
}

/// The install's billing cycle (BIL-280). One row at most (id is always 1);
/// no row means the defaults apply: automatic billing off (BIL-281).
model BillingSettings {
  id                       Int         @id @default(1) @db.SmallInt
  automaticBillingEnabled  Boolean     @map("automatic_billing_enabled")
  billingMode              BillingMode @map("billing_mode")
  issueLeadDays            Int         @map("issue_lead_days") @db.SmallInt
  graceDays                Int         @map("grace_days") @db.SmallInt
  automaticCutEnabled      Boolean     @default(false) @map("automatic_cut_enabled")
  reminderWhatsAppTemplate String?     @map("reminder_whatsapp_template") @db.VarChar(512)
  billWhatsAppTemplate     String?     @map("bill_whatsapp_template") @db.VarChar(512)
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@map("billing_settings")
}

// Cuentas de cobro: one-off charges for work outside the internet service
// (camera installs, equipment, repairs). Deliberately separate from Bill,
// which is tied to subscriptions and one-per-period.

enum CollectionAccountStatus {
  PENDING
  PAID
  CANCELLED

  @@map("collection_account_status")
}

model CollectionAccount {
  id     String                  @id @default(uuid()) @db.Uuid
  code   Int                     @unique @default(autoincrement())
  status CollectionAccountStatus @default(PENDING)

  customerId String? @map("customer_id") @db.Uuid

  // Customer snapshot — captured at issue time, never re-resolved.
  customerName     String  @map("customer_name") @db.VarChar(150)
  customerDocument String? @map("customer_document") @db.VarChar(20)
  customerPhone    String? @map("customer_phone") @db.VarChar(20)
  customerEmail    String? @map("customer_email") @db.VarChar(255)
  customerAddress  String? @map("customer_address") @db.VarChar(255)

  issueDate DateTime  @map("issue_date") @db.Timestamptz
  dueDate   DateTime? @map("due_date") @db.Timestamptz
  notes     String?   @db.Text

  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer        Customer?                         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineItems       CollectionAccountLineItem[]
  paymentAccounts CollectionAccountPaymentAccount[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("collection_accounts")
}

model CollectionAccountLineItem {
  id                  String  @id @default(uuid()) @db.Uuid
  collectionAccountId String  @map("collection_account_id") @db.Uuid
  description         String  @db.VarChar(500)
  unitPrice           Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity            Int

  collectionAccount CollectionAccount @relation(fields: [collectionAccountId], references: [id], onDelete: Cascade)

  @@index([collectionAccountId])
  @@map("collection_account_line_items")
}

// Snapshot of a BankAccount copied onto a cuenta de cobro at issue time. No
// FK to bank_accounts: the document must keep printing what it said even
// after the account is edited or deleted.
model CollectionAccountPaymentAccount {
  id                  String          @id @default(uuid()) @db.Uuid
  collectionAccountId String          @map("collection_account_id") @db.Uuid
  position            Int
  bankName            String          @map("bank_name") @db.VarChar(100)
  accountType         BankAccountType @map("account_type")
  accountNumber       String          @map("account_number") @db.VarChar(30)

  collectionAccount CollectionAccount @relation(fields: [collectionAccountId], references: [id], onDelete: Cascade)

  @@index([collectionAccountId])
  @@map("collection_account_payment_accounts")
}

// The issuer's own accounts that customers pay into, picked per cuenta de
// cobro.

enum BankAccountType {
  SAVINGS
  CHECKING

  @@map("bank_account_type")
}

model BankAccount {
  id            String          @id @default(uuid()) @db.Uuid
  bankName      String          @map("bank_name") @db.VarChar(100)
  accountType   BankAccountType @map("account_type")
  accountNumber String          @map("account_number") @db.VarChar(30)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([bankName, accountNumber])
  @@map("bank_accounts")
}

// ============================================================================
// QUOTING BOUNDED CONTEXT
// ============================================================================
// Cotizaciones: sales proposals a technician assembles from catalog hardware
// (DeviceModel) with a manually-entered price, sent to a customer or
// prospect, and exported as a PDF.
// ============================================================================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("quotation_status")
}

model Quotation {
  id     String          @id @default(uuid()) @db.Uuid
  code   Int             @unique @default(autoincrement())
  status QuotationStatus @default(DRAFT)

  customerId String? @map("customer_id") @db.Uuid

  // Customer snapshot — captured at creation, never re-resolved. A
  // quotation is a point-in-time offer, and Customer has no address field
  // at all, so the address can only ever come from this free-text snapshot.
  customerName    String  @map("customer_name") @db.VarChar(150)
  customerPhone   String? @map("customer_phone") @db.VarChar(20)
  customerEmail   String? @map("customer_email") @db.VarChar(255)
  customerAddress String? @map("customer_address") @db.VarChar(255)

  validUntil DateTime @map("valid_until") @db.Timestamptz
  notes      String?  @db.Text

  sentAt          DateTime? @map("sent_at") @db.Timestamptz
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.VarChar(255)
  expiredAt       DateTime? @map("expired_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer  Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineItems QuotationLineItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationLineItem {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid

  // Snapshot of the referenced DeviceModel at the time it was added to the
  // quote, so the PDF stays stable even if the catalog changes later. The FK
  // is nullable and SetNull on delete for the same reason: all display data
  // needed to render the line already lives in the snapshot columns below.
  deviceModelId   String? @map("device_model_id") @db.Uuid
  deviceModelName String  @map("device_model_name") @db.VarChar(150)
  vendorName      String  @map("vendor_name") @db.VarChar(100)
  deviceType      String  @map("device_type") @db.VarChar(50)
  imageUrl        String? @map("image_url") @db.VarChar(500)

  description String  @db.VarChar(500)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int

  quotation   Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  deviceModel DeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([deviceModelId])
  @@map("quotation_line_items")
}

// ============================================================================
// TICKETS BOUNDED CONTEXT
// ============================================================================
// Field work orders. A ticket is the unit of work a technician is dispatched
// to do: what broke, who to call, which device, and where to go.
// ============================================================================

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum TicketCategory {
  CONNECTIVITY
  INSTALLATION
  HARDWARE_FAILURE
  MAINTENANCE
  RELOCATION
  SITE_SURVEY
  OTHER

  @@map("ticket_category")
}

enum TicketOrigin {
  MANUAL
  DEVICE_ALERT
  WIRELESS_ALERT

  @@map("ticket_origin")
}

model Technician {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String   @unique @db.VarChar(20)
  email     String?  @unique @db.VarChar(255)
  userId    String?  @unique @map("user_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tickets Ticket[]

  @@index([isActive])
  @@map("technicians")
}

model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  code        Int            @unique @default(autoincrement())
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  category    TicketCategory
  title       String         @db.VarChar(150)
  description String         @db.Text

  customerId   String? @map("customer_id") @db.Uuid
  deviceId     String? @map("device_id") @db.Uuid
  technicianId String? @map("technician_id") @db.Uuid

  // Address snapshot — captured at creation, never re-resolved. There is no
  // customer address anywhere else in the schema, and a historical ticket must
  // keep the address it was actually worked at.
  addressStreet       String?  @map("address_street") @db.VarChar(255)
  addressMunicipality String?  @map("address_municipality") @db.VarChar(100)
  addressNeighborhood String?  @map("address_neighborhood") @db.VarChar(150)
  addressReference    String?  @map("address_reference") @db.VarChar(255)
  latitude            Decimal? @db.Decimal(10, 7)
  longitude           Decimal? @db.Decimal(10, 7)

  // On-site contact snapshot — the only record of a prospect who is not a
  // customer yet. Free text, like the quotation's customer snapshot.
  contactName  String? @map("contact_name") @db.VarChar(150)
  contactPhone String? @map("contact_phone") @db.VarChar(20)

  scheduledFor       DateTime?    @map("scheduled_for") @db.Date
  // Optional wall-clock window (HH:mm) within scheduled_for. Not timestamps:
  // the block must stay on its scheduled day regardless of zone.
  scheduledStartTime String?      @map("scheduled_start_time") @db.VarChar(5)
  scheduledEndTime   String?      @map("scheduled_end_time") @db.VarChar(5)
  origin             TicketOrigin @default(MANUAL)
  // Not a foreign key: points at alert_events or wireless_alert_records
  // depending on `origin`, so the reference cannot be expressed as an FK.
  originAlertId      String?      @map("origin_alert_id") @db.Uuid

  resolutionNotes String?   @map("resolution_notes") @db.Text
  cancelReason    String?   @map("cancel_reason") @db.VarChar(255)
  createdBy       String?   @map("created_by") @db.Uuid
  assignedAt      DateTime? @map("assigned_at") @db.Timestamptz
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([technicianId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([customerId])
  @@index([deviceId])
  @@index([origin, originAlertId])
  @@map("tickets")
}

// ============================================================================
// PROBE AGENTS BOUNDED CONTEXT
// ============================================================================
// On-site agents that measure a customer's network and report to this
// backend (ADR 0002). Only hashes of the pairing code and the token are
// stored; both are shown once and never again.
// ============================================================================

enum AgentStatus {
  PENDING
  ACTIVE
  REVOKED

  @@map("agent_status")
}

enum AgentUpdateOutcome {
  INSTALLED
  ROLLED_BACK
  REJECTED

  @@map("agent_update_outcome")
}

model ProbeAgent {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @unique @db.VarChar(60)
  status            AgentStatus         @default(PENDING)
  pairingCodeHash   String?             @unique @map("pairing_code_hash") @db.Char(64)
  pairingExpiresAt  DateTime?           @map("pairing_expires_at") @db.Timestamptz
  tokenHash         String?             @unique @map("token_hash") @db.Char(64)
  enrolledAt        DateTime?           @map("enrolled_at") @db.Timestamptz
  revokedAt         DateTime?           @map("revoked_at") @db.Timestamptz
  lastSeenAt        DateTime?           @map("last_seen_at") @db.Timestamptz
  agentVersion      String?             @map("agent_version") @db.VarChar(32)
  clockOffsetMs     Int?                @map("clock_offset_ms")
  // Set when an active agent has been silent past the offline threshold
  // (R6); cleared by its next contact. Null means online.
  offlineSince      DateTime?           @map("offline_since") @db.Timestamptz
  // Set when the PC's clock drifted more than a minute from ours (R12);
  // cleared once it is back within 30 seconds. Null means the clock is fine.
  clockDriftSince   DateTime?           @map("clock_drift_since") @db.Timestamptz
  // How the last self-update the agent reported ended (AGT-084): the version
  // it tried, the outcome, and why it failed. All null until the first one;
  // a CHECK constraint (migration 20261001120000) keeps them together.
  lastUpdateVersion String?             @map("last_update_version") @db.VarChar(32)
  lastUpdateOutcome AgentUpdateOutcome? @map("last_update_outcome")
  lastUpdateReason  String?             @map("last_update_reason") @db.VarChar(500)
  lastUpdateAt      DateTime?           @map("last_update_at") @db.Timestamptz
  // Source of the short per-device indexes in config snapshots (R19). Only
  // ever increases, so an index is never handed to a second device — not even
  // after the first one is purged.
  nextDeviceIndex   Int                 @default(0) @map("next_device_index")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  devices       Device[]
  deviceIndexes ProbeAgentDeviceIndex[]
  outages       ProbeAgentOutage[]

  @@map("probe_agents")
}

// One row per time an agent went offline (AGT-026). Kept in step with
// probe_agents.offline_since by PrismaAgentRepository, in the same
// transaction. At most one open row (ended_at null) per agent: a partial
// unique index in the migration enforces it.
model ProbeAgentOutage {
  id           String    @id @default(uuid()) @db.Uuid
  agentId      String    @map("agent_id") @db.Uuid
  // Last contact before the silence: when the outage really began.
  silentSince  DateTime  @map("silent_since") @db.Timestamptz
  // When the liveness check noticed and marked the agent offline.
  offlineSince DateTime  @map("offline_since") @db.Timestamptz
  endedAt      DateTime? @map("ended_at") @db.Timestamptz
  // RECONNECTED or REVOKED; null while open.
  endReason    String?   @map("end_reason") @db.VarChar(16)

  agent ProbeAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, offlineSince(sort: Desc)])
  @@map("probe_agent_outages")
}

model ProbeAgentDeviceIndex {
  agentId     String @map("agent_id") @db.Uuid
  deviceId    String @map("device_id") @db.Uuid
  deviceIndex Int    @map("device_index")

  agent  ProbeAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  device Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([agentId, deviceId])
  @@unique([agentId, deviceIndex])
  @@map("probe_agent_device_indexes")
}

// ============================================================================
// DEVICE BACKUPS BOUNDED CONTEXT
// ============================================================================

enum BackupFormat {
  AIROS_CFG
  ROUTEROS_EXPORT

  @@map("backup_format")
}

enum BackupTrigger {
  SCHEDULED
  MANUAL

  @@map("backup_trigger")
}

enum BackupOutcome {
  SAVED
  UNCHANGED
  FAILED

  @@map("backup_outcome")
}

// One saved version of a device's configuration (BKP-001). The file holds
// device passwords and wireless keys, so it is stored encrypted with
// DEVICE_CREDENTIALS_KEY (BKP-040).
model ConfigBackup {
  id               String        @id @default(uuid()) @db.Uuid
  deviceId         String        @map("device_id") @db.Uuid
  format           BackupFormat
  contentHash      String        @map("content_hash") @db.Char(64)
  sizeBytes        Int           @map("size_bytes")
  trigger          BackupTrigger
  encryptedContent String        @map("encrypted_content") @db.Text
  takenAt          DateTime      @map("taken_at") @db.Timestamptz
  lastCheckedAt    DateTime      @map("last_checked_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, takenAt(sort: Desc)])
  @@map("config_backups")
}

model DeviceBackupState {
  deviceId            String         @id @map("device_id") @db.Uuid
  lastAttemptAt       DateTime?      @map("last_attempt_at") @db.Timestamptz
  lastOutcome         BackupOutcome? @map("last_outcome")
  lastError           String?        @map("last_error") @db.VarChar(500)
  lastSuccessAt       DateTime?      @map("last_success_at") @db.Timestamptz
  failingSince        DateTime?      @map("failing_since") @db.Timestamptz
  consecutiveFailures Int            @default(0) @map("consecutive_failures")
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_backup_states")
}

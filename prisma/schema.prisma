// ============================================================================
// ISP Watch — V1 Schema
// ============================================================================
// 6 tables. No multi-tenancy. Ping-only monitoring.
// Goal: "I can see what's down and get notified."
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// DEVICE MODEL (global hardware catalog)
// ============================================================================
// ~15-20 rows. Current hardware: Ubiquiti LiteBeam, MikroTik hAP, etc.
// ============================================================================

enum DeviceType {
  // TODO - Refine device types based on actual hardware catalog and monitoring needs
  /*
  BRIDGE
  EDGE
  FIREWALL
  MODEM
  OLT
  SECURITY
  WIRELESS
  ONT*/
  ANTENNA
  OTHER
  RADIO
  ROUTER
  ROUTERBOARD
  SERVER
  SWITCH

  @@map("device_type")
}

enum Vendors {
  // TODO - Refine vendor list based on actual hardware catalog and procurement history
  /*CISCO
  ARUBA
  ARISTA
  CAMBIUM
  JUNIPER
  HUAWEI
  HPE
  EXTREME_NETWORKS
  RADWIN
  CERAGON*/
  TP_LINK
  MIKROTIK
  UBIQUITI
  MIMOSA
  TENDA
  OTHER

  @@map("vendors")
}

model DeviceModel {
  id              String        @id @default(uuid()) @db.Uuid
  manufacturer    Vendors
  model           String        @db.VarChar(150)
  deviceType      DeviceType    @map("device_type")
  //operatingSystem OperatingSystems?
  //specifications  String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  devices         Device[]
  //suppliers       Supplier[]

  @@unique([manufacturer, model])
  @@map("device_models")
}

// ============================================================================
// LOCATION (infrastructure sites)
// ============================================================================
// Towers, nodes, office, warehouse. Not customer premises.
// ============================================================================

enum LocationType {
  TOWER
  NODE
  DATACENTER
  POP
  WAREHOUSE
  OFFICE

  @@map("location_type")
}

model Location {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(150)
  type         LocationType
  municipality String?      @db.VarChar(100)
  neighborhood String?      @db.VarChar(150)
  address      String?      @db.VarChar(255)
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  altitude     Decimal?     @db.Decimal(7, 2)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  devices Device[]

  @@map("locations")
}

// ============================================================================
// DEVICE
// ============================================================================
// Network devices. The core entity.
// Network fields (ip_address) nullable for warehouse inventory.
// ============================================================================


enum DeviceStatus {
  ACTIVE
  DAMAGED
  DECOMMISSIONED
  INVENTORY
  MAINTENANCE

  @@map("device_status")
}

enum DeviceCategory {
  CORE
  DISTRIBUTION
  POE
  ACCESS_POINT
  CLIENT_CPE

  @@map("device_category")
}

enum DeviceOwnerType {
  COMPANY
  CLIENT
  //THIRD_PARTY

  @@map("device_owner")
}

model Device {
  id            String          @id @default(uuid()) @db.Uuid
  deviceModelId String          @map("device_model_id") @db.Uuid
  locationId    String?         @map("location_id") @db.Uuid
  status        DeviceStatus    @default(INVENTORY)
  category      DeviceCategory?
  owner         DeviceOwnerType @default(COMPANY)

  //Identity
  name             String  @db.VarChar(150)
  serialNumber     String? @map("serial_number") @db.VarChar(100) 
  macAddress       String? @map("mac_address") @db.VarChar(17)
  ipAddress        String? @map("ip_address") @db.VarChar(45)
  description      String?   @db.Text

  // Lifecycle
  installedDate DateTime? @map("installed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Monitoring
  monitoringEnabled Boolean @default(true) @map("monitoring_enabled")

  // Relations
  deviceModel           DeviceModel           @relation(fields: [deviceModelId], references: [id])
  location              Location?             @relation(fields: [locationId], references: [id])
  pollingConfiguration  PollingConfiguration?
  deviceState           DeviceState?
  pingResults           PingResult[]
  alertEvents           AlertEvent[]

  @@map("devices")
}

// ============================================================================
// DEVICE STATE (current status cache — 1:1 with Device)
// ============================================================================
// Updated every ping cycle. This is what the dashboard reads.
// One row per device. Overwritten, not appended.
// ============================================================================

model DeviceState {
  id                  String   @id @default(uuid()) @db.Uuid
  deviceId            String   @unique @map("device_id") @db.Uuid
  isOnline            Boolean  @default(false) @map("is_online")
  lastSeen            DateTime? @map("last_seen") @db.Timestamptz
  lastLatencyMs       Decimal? @map("last_latency_ms") @db.Decimal(8, 2)
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_states")
}

// ============================================================================
// PING RESULT (time-series — append only)
// ============================================================================
// One row per ping per device. High volume: 300 devices × 1/min = 432K/day.
// Retention policy: keep raw data 30 days, then delete.
// Partition by month if needed later.
// ============================================================================

model PingResult {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  isReachable Boolean  @map("is_reachable")
  latencyMs   Decimal? @map("latency_ms") @db.Decimal(8, 2)
  checkedAt   DateTime @default(now()) @map("checked_at") @db.Timestamptz

  // Relations
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, checkedAt(sort: Desc)])
  @@index([checkedAt])
  @@map("ping_results")
}

// ============================================================================
// ALERT EVENT (device went down / recovered)
// ============================================================================
// Created when a device crosses the failure threshold.
// Closed (resolved_at set) when it comes back online.
// This drives notifications (WhatsApp, email).
// ============================================================================

enum AlertSeverity {
  WARNING
  CRITICAL

  @@map("alert_severity")
}

model AlertEvent {
  id          String        @id @default(uuid()) @db.Uuid
  deviceId    String        @map("device_id") @db.Uuid
  severity    AlertSeverity @default(CRITICAL)
  startedAt   DateTime      @default(now()) @map("started_at") @db.Timestamptz
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz
  notifiedAt  DateTime?     @map("notified_at") @db.Timestamptz
  recoveryNotifiedAt DateTime? @map("recovery_notified_at") @db.Timestamptz
  durationSecs Int?         @map("duration_secs")

  // Relations
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, startedAt(sort: Desc)])
  @@index([resolvedAt])
  @@map("alert_events")
}

// ===================================
// POLLING SYSTEM MODELS (Sprint 1)
// ===================================


/// Polling configuration for continuous device monitoring.
/// Defines how often and how many pings should be executed.
model PollingConfiguration {
  id                  String    @id @default(uuid()) @db.Uuid
  deviceId            String    @unique @map("device_id") @db.Uuid
  ipAddress           String?   @map("ip_address") @db.VarChar(45)
  enabled             Boolean   @default(true)
  pingIntervalSecs    Int       @default(60) @map("interval_seconds") // Polling interval (1-86400 seconds)
  failuresBeforeDown  Int       @default(3) @map("failures_before_down") // Consecutive failures before marking device as down
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@map("polling_configurations")
}


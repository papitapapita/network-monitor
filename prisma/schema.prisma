// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  ROUTER
  SWITCH
  RADIO
  FIREWALL
  SERVER
  MODEM
  ONT
  OLT
  WIRELESS
  SECURITY
  EDGE
}

enum DeviceRole {
  ROUTING
  SWITCHING
  FIREWALL
  VPN
}

enum RouterType {
  CORE_ROUTER
  EDGE_ROUTER
  VIRTUAL_ROUTER
  WIRELESS_ROUTER
}

enum SwitchType {
  UNMANAGED_SWITCH
  MANAGED_SWITCH
  LAYER2_SWITCH
  LAYER3_SWITCH
  POE_SWITCH
  CORE_SWITCH
  DISTRIBUTION_SWITCH
  ACCESS_SWITCH
}

enum WirelessType {
  ACCESS_POINT
  WIRELESS_CONTROLLER
  WIRELESS_BRIDGE
  MESH_ACCESS_POINT
}

enum RadioType {
  PTP_RADIO
  PTMP_RADIO
  SECTOR_ANTENNA
  BACKHAUL_RADIO
  MIMO_RADIO
}

enum SecurityDeviceType {
  FIREWALL
  NEXT_GENERATION_FIREWALL
  UTM
  IDS
  IPS
  VPN
  NAC
  AUTHENTICATION_SERVER
}

enum ServerType {
  APPLICATION_SERVER
  DATABASE_SERVER
  PROXY_SERVER
  DHCP_SERVER
  DNS_SERVER
  LOAD_BALANCER
  CDN_NODE
  SYSLOG_SERVER
}

enum MonitoringHardwareType {
  NETWORK_MONITORING_PROBE
  SNMP_PROBE
  OOB_MANAGEMENT_DEVICE
  KVM
  ENVIRONMENTAL_SENSOR
  REMOTE_PDU
}

enum PowerSystemType {
  UPS
  PDU
  RECTIFIER
  INVERTER
  POE_INJECTOR
  SOLAR_CHARGE_CONTROLLER
  BATTERY_BANK
}

enum PhysicalComponentsType {
  PATCH_PANEL
  ODF
  FDF
  NETWORK_RACK
  CABINET
  GROUNDING_SYSTEM
  LIGHTNING_ARRESTOR
  SURGE_PROTECTOR
  SPLICE_BOX
  FIBER_PATCH_CORD
  PIGTAIL
  ETHERNET_CABLE_REEL
}

enum ISPDevicesType {
  OLT
  BRAS
  PPPOE_SERVER
  CGNAT
  AAA_SERVER
  BANDWITH_MANAGER
  TRAFFIC_SHAPER
  TOWER_CONTROLLER
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum NetworkDeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  DEGRADED
  MAINTENANCE
  OUT_OF_SERVICE
  DAMAGED
}

// Possible owners of the device
enum DeviceOwner {
  COMPANY
  CLIENT
  THIRD_PARTY
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
  EMERGENCY
}

enum NetworkDeviceType {
  CORE_ROUTER
  EDGE_ROUTER
  DISTRIBUTION_SWITCH
  ACCESS_SWITCH
  WIRELESS_ACCESS_POINT
  FIREWALL
  LOAD_BALANCER
  ACCESS_POINT
  MODEM
  OTHER
}

enum ConnectivityType {
  ETHERNET
  FIBER_OPTIC
  WIRELESS
  DSL
  SATELLITE
  OTHER
}

enum ManagementProtocol {
  SNMP
  SSH
  TELNET
  HTTP
  HTTPS
  OTHER
}

enum EnergySourceType {
  SOLAR
  BATTERY
  MAINS
  GENERATOR
  POE
  OTHER
}

enum BackupEnergyType {
  UPS
  BATTERY_BANK
  SOLAR_PANEL
  NONE
  OTHER
}

enum Vendors {
  MIKROTIK
  UBIQUITI
  MIMOSA
  CISCO
  ARUBA
  CAMBIUM
  OTHER
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  contactInfo    String?
  location       String?
  deviceModels   DeviceModel[]
  purchaseOrders PurchaseOrder[]
}

model DeviceModel {
  idInt           Int        @id @default(autoincrement())
  model           String
  manufacturer    Vendors
  type            DeviceType
  operatingSystem String?
  specifications  String?
  suppliers       Supplier[]
  devices         Device[]
}

model PurchaseOrder {
  id           Int      @id @default(autoincrement())
  orderNumber  String   @unique
  date         DateTime @default(now())
  observations String?
  totalPrice   Float
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  supplierId   Int
  devices      Device[]
}

model Device {
  id               Int            @id @default(autoincrement())
  status           DeviceStatus   @default(INACTIVE)
  owner            DeviceOwner    @default(COMPANY)
  serialNumber     String         @unique
  guaranteeEndDate DateTime?
  deviceModel      DeviceModel    @relation(fields: [deviceModelId], references: [idInt])
  deviceModelId    Int
  purchaseOrders   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId  Int
  location         Location?      @relation(fields: [locationId], references: [id])
  locationId       Int            @unique
  networkDevice    NetworkDevice?
}

model Location {
  id           Int     @id @default(autoincrement())
  coordenates  String
  city         String
  neighborhood String
  address      String?
  device       Device?
}

model NetworkDevice {
  id                    Int                    @id @default(autoincrement())
  name                  String
  type                  NetworkDeviceType
  description           String?
  installDate           DateTime               @default(now())
  ipAddress             String                 @unique
  macAddress            String                 @unique
  connectivityType      ConnectivityType
  managementProtocol    ManagementProtocol
  managementPort        Int
  enabledRemoteAccess   Boolean                @default(false)
  device                Device                 @relation(fields: [deviceId], references: [id])
  deviceId              Int                    @unique
  radioAntenna          RadioAntenna?
  deviceSoftware        DeviceSoftware?
  deviceMaintenanceLogs DeviceMaintenanceLog[]
  deviceSecurity        DeviceSecurity?
  deviceLogs            DeviceLogs[]
  deviceEnergy          DeviceEnergy?
  deviceMonitoring      DeviceMonitoring?
}

enum RadioAntennaType {
  ACCESS_POINT
  STATION
}

model RadioAntenna {
  id              Int              @id @default(autoincrement())
  power           Float?
  antennaGain     Float?
  height          Float?
  frequencyRange  String?
  type            RadioAntennaType
  networkDevice   NetworkDevice    @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId Int              @unique
  accessPoint     AccessPoint?
  link            Link?
}

model AccessPoint {
  id               Int          @id @default(autoincrement())
  ssid             String
  frequencyChannel Int?
  bandwidth        Float?
  ptpMode          Boolean      @default(false)
  password         String?
  radioAntenna     RadioAntenna @relation(fields: [radioAntennaId], references: [id])
  radioAntennaId   Int          @unique
  link             Link?        
}

model Link {
  id               Int     @id @default(autoincrement())
  name             String
  description      String?
  rxThroughput     Float
  txThroughput     Float
  rxSignalStrength Float?
  txSignalStrength Float?
  latency          Float?
  distance         Float?
  sourceDevice     AccessPoint @relation(fields: [sourceDeviceId], references: [id])
  sourceDeviceId   Int         @unique
  destinationDevice RadioAntenna     @relation(fields: [destinationDeviceId], references: [id])
  destinationDeviceId Int            @unique
}

model DeviceSoftware {
  id              Int           @id @default(autoincrement())
  version         String
  releaseDate     DateTime
  lastUpdateDate  DateTime?
  backupLink      String?
  networkDevice   NetworkDevice @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId Int           @unique
}

model Technician {
  id                    Int                    @id @default(autoincrement())
  name                  String
  contactInfo           String?
  deviceMaintenanceLogs DeviceMaintenanceLog[]
}

model DeviceMaintenanceLog {
  id              Int             @id @default(autoincrement())
  date            DateTime        @default(now())
  description     String
  type            MaintenanceType
  performedBy     Technician      @relation(fields: [performedById], references: [id])
  performedById   Int
  networkDevice   NetworkDevice   @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId Int
}

model DeviceSecurity {
  id              Int           @id @default(autoincrement())
  username        String
  password        String
  SNMPPassword    String?
  networkDevice   NetworkDevice @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId Int           @unique
}

model DeviceLogs {
  id              Int           @id @default(autoincrement())
  timestamp       DateTime      @default(now())
  logLevel        LogLevel
  message         String
  networkDevice   NetworkDevice @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId Int
}

model DeviceEnergy {
  id               Int              @id @default(autoincrement())
  sourceType       EnergySourceType
  powerConsumption Float
  voltage          Float
  current          Float
  backUpEnergy     BackupEnergyType
  networkDevice    NetworkDevice    @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId  Int              @unique
}

model DeviceMonitoring {
  id              Int                 @id @default(autoincrement())
  uptime          Int
  temperature     Float
  status          NetworkDeviceStatus
  avgLatency      Float
  packetsLost     Float
  rxThroughput    Float
  txThroughput    Float
  alertsEnabled   Boolean             @default(true)
  lastMonitoring  DateTime            @default(now())
  cpuUsage        Float
  memoryUsage     Float
  diskUsage       Float
  networkDevice   NetworkDevice       @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId Int                 @unique
}

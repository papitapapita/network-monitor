generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  ROUTER
  SWITCH
  RADIO
  FIREWALL
  SERVER
  MODEM
  ONT
  OLT
  WIRELESS
  SECURITY
  EDGE
}

enum RouterType {
  CORE_ROUTER
  EDGE_ROUTER
  VIRTUAL_ROUTER
  WIRELESS_ROUTER
}

enum SwitchType {
  UNMANAGED_SWITCH
  MANAGED_SWITCH
  LAYER2_SWITCH
  LAYER3_SWITCH
  POE_SWITCH
  CORE_SWITCH
  DISTRIBUTION_SWITCH
  ACCESS_SWITCH
}

enum RadioType {
  ACCESS_POINT
  PTP_RADIO
  PTMP_RADIO
  SECTOR_ANTENNA
  BACKHAUL_RADIO
  MIMO_RADIO
  STATION
}

enum SecurityDeviceType {
  FIREWALL
  NEXT_GENERATION_FIREWALL
  UTM
  IDS
  IPS
  VPN
  NAC
  AUTHENTICATION_SERVER
}

enum ServerType {
  APPLICATION_SERVER
  DATABASE_SERVER
  PROXY_SERVER
  DHCP_SERVER
  DNS_SERVER
  LOAD_BALANCER
  CDN_NODE
  SYSLOG_SERVER
}

enum MonitoringHardwareType {
  NETWORK_MONITORING_PROBE
  SNMP_PROBE
  OOB_MANAGEMENT_DEVICE
  KVM
  ENVIRONMENTAL_SENSOR
  REMOTE_PDU
}

enum PowerSystemType {
  UPS
  PDU
  RECTIFIER
  INVERTER
  POE_INJECTOR
  SOLAR_CHARGE_CONTROLLER
  BATTERY_BANK
}

enum PhysicalComponentsType {
  PATCH_PANEL
  ODF
  FDF
  NETWORK_RACK
  CABINET
  GROUNDING_SYSTEM
  LIGHTNING_ARRESTOR
  SURGE_PROTECTOR
  SPLICE_BOX
  FIBER_PATCH_CORD
  PIGTAIL
  ETHERNET_CABLE_REEL
}

enum ISPDevicesType {
  OLT
  BRAS
  PPPOE_SERVER
  CGNAT
  AAA_SERVER
  BANDWITH_MANAGER
  TRAFFIC_SHAPER
  TOWER_CONTROLLER
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum NetworkDeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  DEGRADED
  MAINTENANCE
  OUT_OF_SERVICE
  DAMAGED
}

// Possible owners of the device
enum DeviceOwner {
  COMPANY
  CLIENT
  THIRD_PARTY
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
  EMERGENCY
}

enum NetworkDeviceRole {
  ROUTING
  SWITCHING
  WIRELESS_ACCESS
  WIRELESS_CONTROLLER
  WIRELESS_BRIDGE
  RADIO_LINK
  BACKHAUL
  FIREWALL
  IDS
  IPS
  UTM
  VPN
  NAC
  AUTHENTICATION
  APPLICATION_HOSTING
  DATABASE_HOSTING
  PROXY
  DHCP
  DNS
  LOAD_BALANCING
  CDN
  LOGGING
  MONITORING
  SNMP
  OOB_MANAGEMENT
  KVM_ACCESS
  ENVIRONMENT_MONITORING
  POWER_MANAGEMENT
}

enum ConnectivityType {
  ETHERNET
  FIBER_OPTIC
  WIRELESS
  DSL
  SATELLITE
  OTHER
}

enum ManagementProtocol {
  SNMP
  SSH
  TELNET
  HTTP
  HTTPS
  OTHER
}

enum EnergySourceType {
  SOLAR
  BATTERY
  MAINS
  GENERATOR
  POE
  OTHER
}

enum Vendors {
  MIKROTIK
  UBIQUITI
  MIMOSA
  CISCO
  ARUBA
  ARISTA
  CAMBIUM
  JUNIPER
  HUAWEI
  HPE
  EXTREME_NETWORKS
  RADWIN
  CERAGON
  TP_LINK
  OTHER
}

enum OperatingSystems {
  IOS
  IOS_XE
  IOS_XR
  NX_OS
  JUNOS
  EOS
  VRP
  ARUBAOS
  COMWARE
  XOS
  EXOS
  ROUTEROS
  SWITCHOS
  EDGEOS
  UNIFI_OS
  AIROS
  UFIBER_OS
  CNMAESTRO_OS
  EPMP_OS
  MIMOSAOS
  RADWIN_OS
  FIBEAIR_OS
  PHAROS_OS
  OMADA_OS
  FORTIOS
  PAN_OS
  SOPHOS_OS
  GAIA_OS
  SONICOS
  FIREWARE_OS
  PFSENSE_OS
  OPNSENSE_OS
}

model Supplier {
  id             String             @id @default(uuid())
  name           String
  contactInfo    String?
  location       String?
  deviceModels   DeviceModel[]
  purchaseOrders PurchaseOrder[]
}

model DeviceModel {
  id              String        @id @default(uuid())
  model           String
  manufacturer    Vendors
  type            DeviceType
  operatingSystem OperatingSystems?
  specifications  String?
  suppliers       Supplier[]
  devices         Device[]
}

model PurchaseOrder {
  id           String      @id @default(uuid())
  orderNumber  String   @unique
  date         DateTime @default(now())
  observations String?
  totalPrice   Float
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  supplierId   String
  devices      Device[]
}

model Device {
  id               String            @id @default(uuid())
  status           DeviceStatus   @default(INACTIVE)
  owner            DeviceOwner    @default(COMPANY)
  serialNumber     String         @unique
  guaranteeEndDate DateTime?
  deviceModel      DeviceModel    @relation(fields: [deviceModelId], references: [id])
  deviceModelId    String
  purchaseOrders   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId  String
  location         Location?      @relation(fields: [locationId], references: [id])
  locationId       String            @unique
  networkDevice    NetworkDevice?
}

model Location {
  id           String     @id @default(uuid())
  coordenates  String
  city         String
  neighborhood String
  address      String?
  device       Device?
}

model NetworkDevice {
  id                    String                    @id @default(uuid())
  name                  String
  type                  NetworkDeviceRole
  description           String?
  installDate           DateTime               @default(now())
  ipAddress             String                 @unique
  macAddress            String                 @unique
  connectivityType      ConnectivityType
  managementProtocol    ManagementProtocol
  managementPort        Int
  enabledRemoteAccess   Boolean                @default(false)
  device                Device                 @relation(fields: [deviceId], references: [id])
  deviceId              String                    @unique
  radioAntenna          RadioAntenna?
  deviceSoftware        DeviceSoftware?
  deviceMaintenanceLogs DeviceMaintenanceLog[]
  deviceSecurity        DeviceSecurity?
  deviceLogs            DeviceLogs[]
  deviceEnergy          DeviceEnergy?
  deviceMonitoring      DeviceMonitoring?
}

model RadioAntenna {
  id              String              @id @default(uuid())
  power           Float?
  antennaGain     Float?
  height          Float?
  frequencyRange  String?
  type            RadioType
  networkDevice   NetworkDevice    @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId String              @unique
  accessPoint     AccessPoint?
  link            Link?
}

model AccessPoint {
  id               String          @id @default(uuid())
  ssid             String
  frequencyChannel Int?
  bandwidth        Float?
  ptpMode          Boolean      @default(false)
  password         String?
  radioAntenna     RadioAntenna @relation(fields: [radioAntennaId], references: [id])
  radioAntennaId   String          @unique
  link             Link?        
}

model Link {
  id               String     @id @default(uuid())
  name             String
  description      String?
  rxThroughput     Float
  txThroughput     Float
  rxSignalStrength Float?
  txSignalStrength Float?
  latency          Float?
  distance         Float?
  sourceDevice     AccessPoint @relation(fields: [sourceDeviceId], references: [id])
  sourceDeviceId   String         @unique
  destinationDevice RadioAntenna     @relation(fields: [destinationDeviceId], references: [id])
  destinationDeviceId String            @unique
}

model DeviceSoftware {
  id              String           @id @default(uuid())
  version         String
  releaseDate     DateTime
  lastUpdateDate  DateTime?
  backupLink      String?
  networkDevice   NetworkDevice @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId String           @unique
}

model Technician {
  id                    String                    @id @default(uuid())
  name                  String
  contactInfo           String?
  deviceMaintenanceLogs DeviceMaintenanceLog[]
}

model DeviceMaintenanceLog {
  id              String             @id @default(uuid())
  date            DateTime        @default(now())
  description     String
  type            MaintenanceType
  performedBy     Technician      @relation(fields: [performedById], references: [id])
  performedById   String
  networkDevice   NetworkDevice   @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId String
}

model DeviceSecurity {
  id              String           @id @default(uuid())
  username        String
  password        String
  SNMPPassword    String?
  networkDevice   NetworkDevice @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId String           @unique
}

model DeviceLogs {
  id              String           @id @default(uuid())
  timestamp       DateTime      @default(now())
  logLevel        LogLevel
  message         String
  networkDevice   NetworkDevice @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId String
}

model DeviceEnergy {
  id               String              @id @default(uuid())
  sourceType       EnergySourceType
  powerConsumption Float
  voltage          Float
  current          Float
  backUpEnergy     EnergySourceType
  networkDevice    NetworkDevice    @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId  String              @unique
}

model DeviceMonitoring {
  id              String                 @id @default(uuid())
  uptime          Int
  temperature     Float
  status          NetworkDeviceStatus
  avgLatency      Float
  packetsLost     Float
  rxThroughput    Float
  txThroughput    Float
  alertsEnabled   Boolean             @default(true)
  lastMonitoring  DateTime            @default(now())
  cpuUsage        Float
  memoryUsage     Float
  diskUsage       Float
  networkDevice   NetworkDevice       @relation(fields: [networkDeviceId], references: [id])
  networkDeviceId String                 @unique
}

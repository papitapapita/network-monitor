# Copy to $NMS_CUSTOMERS_DIR/vendor.env (default ~/nms-customers/vendor.env)
# and fill in. Shared by every customer install new-customer.sh creates.

# Product bot (@nms_superadmin_bot). Sends the customer's alerts once its
# administrator saves a chat from the dashboard, and the vendor chat's.
TELEGRAM_BOT_TOKEN=
# Your own chat for agent-health and subscription notices (AGT-023).
TELEGRAM_VENDOR_CHAT_ID=
# Your login on every install (IDN-011). Each install gets its own password.
VENDOR_EMAIL=
# Parent domain; a customer named "acme" is served at acme.<domain>.
CUSTOMER_DOMAIN=miredcontrol.com
# Folder with the agent installers and releases, shared read-only by every
# install (INS-042, AGT-080).
INSTALLERS_DIR=
